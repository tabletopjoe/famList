# Copy to .env and fill in. Required for dev, build, and deploy.

# Postgres connection string.
#   - Local dev: a local Postgres, e.g.
#       postgresql://postgres:postgres@localhost:5432/famlist?schema=public
#   - Production (Vercel + Neon): the connection string from the Neon
#     project dashboard, e.g.
#       postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require
#     Set this as an Environment Variable in the Vercel project settings.
DATABASE_URL=

# Secret used to sign session cookies (HS256 JWT). Generate with:
#   openssl rand -base64 32
AUTH_SECRET=
