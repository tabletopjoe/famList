# Copy to .env and fill in. Required for dev, build, and deploy.

# Postgres connection string.
#   - Local dev: a local Postgres instance, e.g.
#       postgresql://postgres:postgres@localhost:5432/famlist?schema=public
#   - Railway: set this in the service variables as a reference to the
#     Postgres plugin:  ${{Postgres.DATABASE_URL}}
DATABASE_URL=

# Secret used to sign session cookies (HS256 JWT). Generate with:
#   openssl rand -base64 32
AUTH_SECRET=
