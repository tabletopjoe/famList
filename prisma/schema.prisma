// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  name               String
  passwordHash       String
  role               String   @default("member") // "admin" | "member"
  // Forces a redirect to /settings until the user sets their own password.
  // Set true when an account is created (seed script or, later, /admin);
  // cleared by the change-password action once they do.
  mustChangePassword Boolean  @default(false)
  // Which list this user lands on by default — a personal preference, not a
  // property of the list itself (replaces the old global List.isPrimary).
  primaryListId      String?  @unique
  primaryList        List?    @relation("UserPrimaryList", fields: [primaryListId], references: [id], onDelete: SetNull)
  // Display theme + light/dark mode — see THEMES in src/lib/themes.ts for
  // the valid set and what each looks like. Plain strings + Zod validation
  // (same pattern as List.kind), not Postgres enums, so adding a theme or
  // mode is just a code change, no migration. Baked into the session cookie
  // (see src/lib/auth/session.ts) so the root layout can paint the right
  // theme without a DB round trip on every request.
  theme              String   @default("eggplant")
  themeMode          String   @default("dark")
  createdAt          DateTime @default(now())

  lists            List[]             @relation("ListCreatedBy")
  contacts         Contact[]
  listShares       ListShare[]
  contactSharesAsA ContactSharePair[] @relation("ContactShareUserA")
  contactSharesAsB ContactSharePair[] @relation("ContactShareUserB")
}

model List {
  id                String   @id @default(cuid())
  title             String
  // "shopping" | "collection" | "notes" | "recipe" | "project" — see
  // src/modules/lists/types.ts.
  // Plain string + Zod validation (same pattern as User.role), not a
  // Postgres enum: adding a fourth type later is then just a code change,
  // no migration.
  kind              String   @default("shopping")
  // Shopping lists only: days after being checked off that an item resets
  // to unchecked (so a recurring list doesn't need re-adding every time).
  // Null = no auto-reset. Reconciled lazily on read — see
  // resetStaleShoppingItems in queries.ts — not a background job.
  resetIntervalDays Int?
  // Manual drag order on the lists index page (see reorderLists in
  // actions.ts) — lower sorts first. Not scoped per-viewer: a list's
  // position is shared by everyone it's visible to, same as its title or
  // kind, consistent with sharing being full-edit elsewhere in this app.
  position          Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  createdBy   User   @relation("ListCreatedBy", fields: [createdById], references: [id])
  createdById String

  // The (at most one) user this list is currently the default/primary for.
  primaryFor User? @relation("UserPrimaryList")

  items      ListItem[]
  shares     ListShare[]
  categories Category[]
  statuses   Status[]
}

// Per-list, user-managed labels for grouping items (e.g. "Produce" on a
// shopping list). Shopping and recipe lists get a handful of these
// pre-seeded at creation or when switched to that kind (see
// PRESET_CATEGORIES in types.ts) since those kinds have an obvious default
// set; other kinds start empty.
model Category {
  id       String @id @default(cuid())
  name     String
  // Manual drag order in the list settings menu — lower sorts first.
  position Int    @default(0)

  list   List   @relation(fields: [listId], references: [id], onDelete: Cascade)
  listId String

  items ListItem[]

  @@unique([listId, name])
}

// Per-list, user-managed status values for project-list items — same shape
// and management as Category, just a different field. Project lists get
// "In Progress" / "Completed" / "Canceled" pre-seeded (see PRESET_STATUSES
// in types.ts); users can add, delete, or reorder them freely. A status
// named "Completed" (case-insensitive) is kept in sync with the item's
// isDone checkbox — see COMPLETED_STATUS in types.ts.
model Status {
  id       String @id @default(cuid())
  name     String
  position Int    @default(0)

  list   List   @relation(fields: [listId], references: [id], onDelete: Cascade)
  listId String

  items ListItem[]

  @@unique([listId, name])
}

// Grants one user access to a list they didn't create — per-list, one-
// directional (the owner shares with whoever they choose; being shared
// with doesn't grant sharing back). Full-edit, not view-only: anyone with a
// share can do anything the owner can on that list.
model ListShare {
  id        String   @id @default(cuid())
  listId    String
  userId    String
  createdAt DateTime @default(now())

  list List @relation(fields: [listId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([listId, userId])
}

// Mutual contact-sharing between two users: one row per pair means "these
// two people see all of each other's contacts," not per-contact and not
// directional. App code normalizes (userAId, userBId) — e.g. sorted — so a
// pair never ends up with two conflicting rows depending on who set it up.
model ContactSharePair {
  id        String   @id @default(cuid())
  userAId   String
  userBId   String
  createdAt DateTime @default(now())

  userA User @relation("ContactShareUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB User @relation("ContactShareUserB", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
}

model ListItem {
  id          String    @id @default(cuid())
  label       String
  quantity    String?
  notes       String?
  // Primarily for recipe-list items, pointing at the recipe itself, but not
  // restricted to that list kind.
  link        String?
  isDone      Boolean   @default(false)
  // Shopping-list items only: whether checking this off should auto-reset
  // it later (a staple like milk) vs. stay checked for good (a one-off).
  // Meaningless outside "shopping" lists but stored per-item rather than
  // derived, so it survives a list's kind changing back and forth.
  isRecurring Boolean   @default(true)
  // When isDone last flipped true; cleared when it flips back to false.
  // Read against the parent List's resetIntervalDays to decide when a
  // shopping-list item is due to auto-reset.
  completedAt DateTime?
  position    Int       @default(0)
  createdAt   DateTime  @default(now())

  list   List   @relation(fields: [listId], references: [id], onDelete: Cascade)
  listId String

  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId String?

  // Project-list fields. Like isRecurring, stored per-item regardless of
  // the list's kind so they survive a kind change back and forth. Dates are
  // calendar days (stored as UTC midnight), not instants.
  startDate DateTime?
  dueDate   DateTime?
  // Free text rather than a User relation — the person doing it may not
  // have an account (a kid, a contractor).
  person    String?
  status    Status?   @relation(fields: [statusId], references: [id], onDelete: SetNull)
  statusId  String?
  // Another item in the same list this one waits on: until that item is
  // done, this one is locked and can't be checked off. Single precursor,
  // no cycles (enforced in updateItem). Deleting the precursor frees it.
  dependsOn   ListItem?  @relation("ItemDependency", fields: [dependsOnId], references: [id], onDelete: SetNull)
  dependsOnId String?
  dependents  ListItem[] @relation("ItemDependency")
}

model Contact {
  id           String    @id @default(cuid())
  firstName    String
  lastName     String?
  relationship String? // e.g. "Grandparent", "Cousin", "Friend"
  phone        String?
  email        String?
  address1     String?
  address2     String?
  city         String?
  state        String?
  zip          String?
  birthday     DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String
}
